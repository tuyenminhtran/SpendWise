<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnOpenDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1) Open Detail (Explicit)" />

        <Button
            android:id="@+id/btnSendData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2) Send Data to Detail (Extras)" />

        <Button
            android:id="@+id/btnOpenWeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3) Open Website (Implicit)" />

        <Button
            android:id="@+id/btnDial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4) Dial Phone (Implicit)" />

        <Button
            android:id="@+id/btnEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5) Send Email (Implicit)" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="6) Share Text (Implicit)" />

        <Button
            android:id="@+id/btnPickImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="7) Pick Image (Activity Result API)" />

        <TextView
            android:id="@+id/tvPickedImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Picked image URI will appear here"
            android:paddingTop="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>